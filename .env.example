# Copy to .env and fill in. .env is gitignored.

# Required: used for the matching step (finding answers in transcripts).
OPENAI_API_KEY=

# Required only for --channel (listing a channel's videos + titles).
# Not needed if you pass an explicit --videos file of IDs/URLs.
YOUTUBE_DATA_API_KEY=

# Optional: override the default matching model (default: gpt-5.5).
# Use gpt-5.4-mini to cut cost on large channels.
# LLM_MODEL=gpt-5.5

# Optional: path to the yt-dlp binary used to fetch transcripts.
# Leave unset to use yt-dlp from your PATH or a standard install location.
# YT_DLP_PATH=
